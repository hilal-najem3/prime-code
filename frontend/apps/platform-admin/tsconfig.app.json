{
  // This is the tsconfig.json for the platform-admin app. It extends the main tsconfig.json from the frontend and adds specific compiler options and includes for the platform-admin app.
  // path: frontend/apps/platform-admin/tsconfig.json
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "strict": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.d.ts",

    "../../packages/ui/**/*.ts",
    "../../packages/ui/**/*.vue",

    "../../packages/media/**/*.ts",
    "../../packages/media/**/*.vue",

    "../../packages/core/**/*.ts",

    "../../packages/config/**/*.ts",
    "../../packages/config/**/*.js"
  ],
  "exclude": ["node_modules", "dist"]
}
