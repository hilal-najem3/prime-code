{
  // This is the tsconfig.json for the platform-admin app. It extends the main tsconfig.json from the frontend and adds specific compiler options and includes for the platform-admin app.
  // path: frontend/apps/platform-admin/tsconfig.json
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "strict": true,
    "paths": {
      "@/*": ["apps/platform-admin/src/*"],
      "@config/*": ["packages/config/*"],
      "@core/*": ["packages/core/*"],
      "@ui": ["packages/ui/index.ts"],
      "@ui/*": ["packages/ui/*"],
      "@media": ["packages/media/index.ts"],
      "@media/*": ["packages/media/*"],
      "@shared-assets/*": ["packages/ui/assets/*"],
      "@i18n/*": ["packages/i18n/*"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.d.ts",

    "../../packages/ui/**/*.ts",
    "../../packages/ui/**/*.vue",

    "../../packages/media/**/*.ts",
    "../../packages/media/**/*.vue",

    "../../packages/core/**/*.ts",

    "../../packages/config/**/*.ts",
    "../../packages/config/**/*.js"
  ],
  "exclude": ["node_modules", "dist"]
}
