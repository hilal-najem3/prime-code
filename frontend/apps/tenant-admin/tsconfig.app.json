{
  // path : frontend/apps/tenant-admin/tsconfig.app.json
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "paths": {
      "@/*": ["apps/tenant-admin/src/*"],
      "@config/*": ["packages/config/*"],
      "@core/*": ["packages/core/*"],
      "@ui": ["packages/ui/index.ts"],
      "@ui/*": ["packages/ui/*"],
      "@media": ["packages/media/index.ts"],
      "@media/*": ["packages/media/*"],
      "@shared-assets/*": ["packages/ui/assets/*"],
      "@i18n/*": ["packages/i18n/*"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.d.ts",

    "../../packages/ui/**/*.ts",
    "../../packages/ui/**/*.vue",

    "../../packages/media/**/*.ts",
    "../../packages/media/**/*.vue",

    "../../packages/core/**/*.ts",

    "../../packages/config/**/*.ts",
    "../../packages/config/**/*.js"
  ]
}
