{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "cache": "php artisan optimize:clear && composer dump-autoload",
        "restart": "php artisan optimize:clear && php artisan config:clear && php artisan route:clear && php artisan view:clear && composer dump-autoload && php artisan migrate:fresh --seed"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    }
}
